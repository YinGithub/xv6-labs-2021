{
  // ────────────────────────────────────────────────────────────────
  // xv6-labs-2021: 屏蔽 RISC-V 工具链产生的编译中间产物
  // 让文件树、搜索、Git 视图不被 .o/.d/.asm/.sym 等噪音淹没
  // ────────────────────────────────────────────────────────────────

  // 文件资源管理器中隐藏
  "files.exclude": {
    "**/*.o": true,
    "**/*.d": true,
    "**/*.asm": true,
    "**/*.sym": true,
    "**/*.img": true,
    "**/*.out": true,

    // 内核构建产物
    "kernel/kernel": true,
    "kernel/kernelmemfs": true,
    "kernel/initcode": true,
    "kernel/initcode.out": true,

    // 用户态可执行文件(xv6 约定前缀 _)
    "user/_*": true,
    "user/initcode": true,
    "user/initcode.out": true,

    // mkfs 工具构建产物
    "mkfs/mkfs": true,
    "mkfs/mkfs.*": true,

    // QEMU / lab 运行产生的输出
    "**/qemu.log": true,
    "**/*.log": true,
    "**/console.out": true,

    // 编辑器临时文件
    "**/*.swp": true,
    "**/*~": true,
    "**/.DS_Store": true
  },

  // 跨文件搜索时排除(grep / 全局搜索)
  "search.exclude": {
    "**/*.o": true,
    "**/*.d": true,
    "**/*.asm": true,
    "**/*.sym": true,
    "**/*.img": true,
    "**/*.out": true,
    "**/kernel/kernel": true,
    "**/kernel/kernelmemfs": true,
    "user/_*": true,
    "mkfs/mkfs": true,
    "**/qemu.log": true,
    "**/console.out": true
  },

  // 文件监视器忽略,降低 onchange 风暴
  "files.watcherExclude": {
    "**/*.o": true,
    "**/*.d": true,
    "**/kernel/kernel": true,
    "**/kernel/kernelmemfs": true,
    "user/_*": true,
    "mkfs/mkfs": true,
    "**/fs.img": true
  },

  // 让 C/C++ 扩展识别 RISC-V 工具链
  "C_Cpp.default.compilerPath": "riscv64-unknown-elf-gcc",
  "C_Cpp.default.intelliSenseMode": "gcc-x64",

  // 不在 build 中触发 lint
  "C_Cpp.compilerArgs": [
    "-Wall",
    "-Werror",
    "-O",
    "-fno-omit-frame-pointer",
    "-ggdb",
    "-DSOL_UTIL",
    "-DLAB_UTIL",
    "-ffreestanding",
    "-fno-common",
    "-nostdlib",
    "-mno-relax",
    "-mcmodel=medany",
    "-fno-pie",
    "-fno-stack-protector"
  ],

  // Git 不跟踪这些文件(视图清爽,不影响 .gitignore)
  "git.ignoredResources": [
    "**/*.o",
    "**/*.d",
    "**/*.asm",
    "**/*.sym",
    "**/kernel/kernel",
    "**/kernel/kernelmemfs",
    "user/_*",
    "mkfs/mkfs",
    "**/fs.img"
  ]
}
